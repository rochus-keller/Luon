module Procs10b

	type
		A = record a: integer end
		B = record b: integer end
		
	proc A.test( v: B )
	begin
		assert(self.a = 33)
		assert(v.b = 44)
		println(self.a)
		println(v.b)
	end test
	
	proc A.test2( var v: B )
	begin
		v.b := 55
	end test2
	
	proc A.test3( var v: B): integer
	begin
		v.b := 66
		return 77
	end test3
	
	var a: A
		b: B
begin
	println("Procs10b start")
	new(a)
	a.a := 33

  new(b)
	b.b := 44
	a.test(b)

	a.test2(b)
	assert(b.b = 55)
	assert( a.test3(b) = 77 )
	assert( b.b = 66 )
	
	println("Procs10b done")
end Procs10b
